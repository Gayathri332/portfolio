# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB connection string (MongoDB Atlas free tier works great).
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio
MONGODB_URI=mongodb://localhost:27017/portfolio

# Port the server runs on locally.
PORT=5000

# Secret key you choose yourself. Send it as the "x-admin-key" header
# to add new projects or view contact messages without opening the DB directly.
ADMIN_KEY=change-this-to-something-only-you-know

# Comma-separated list of origins allowed to call the API.
# For local dev the default below is fine. Add your deployed frontend URL
# once you host it somewhere other than this same server.
ALLOWED_ORIGINS=http://localhost:5000

# Powers the "Ask about Gayathri" chat widget: with this set, it does real
# semantic search over a knowledge base built from your resume PDF, about.html,
# certificates, projects, and GitHub repos (run `npm run build-kb` after setting
# this). Get a free key at https://dashboard.cohere.com/api-keys — the same one
# you already use for your LLM File Assistant project works fine here.
# Leave this blank and the widget still works, just with simpler keyword-based
# fallback answers and no GitHub lookups.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-english-v3.0

# GitHub username the chat widget's knowledge base and live repo lookups
# read from. Defaults to Gayathri332 if left blank.
GITHUB_USERNAME=Gayathri332

# Optional. A GitHub personal access token (no scopes needed, public repos
# only) raises the API rate limit from 60/hour to 5000/hour — worth setting
# once the site gets real traffic, since the live GitHub lookup tool calls
# the API on demand. Create one at https://github.com/settings/tokens.
GITHUB_TOKEN=
